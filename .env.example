# 로컬 개발은 비워두면 Vite의 /api 프록시를 사용합니다.
# 배포 환경에서 API 도메인을 직접 호출하려면 백엔드 CORS 허용 후 설정하세요.
VITE_API_BASE_URL=
VITE_CLINICAL_MODEL_VERSION_ID=2
# CT worker와 COCA 모델 연결 완료 후에만 true로 변경합니다.
# staging CCTA E2E(실제 series 추론) 성공 확인 전에는 반드시 false로 유지하세요.
# E2E 성공 후 staging에서 사용할 값: VITE_CT_AI_PIPELINE_READY=true, VITE_CT_AI_MODEL_VERSION_ID=4
# (staging AIModelVersion id=4 = COCA_UNET_CCTA v1.0.3. id=1은 예전 local 가정값이므로 쓰지 않습니다.)
VITE_CT_AI_PIPELINE_READY=false
VITE_CT_AI_MODEL_VERSION_ID=
