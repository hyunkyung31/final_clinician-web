# Staging production build configuration.
# Keep the API base empty so requests use the clinician host's /api reverse proxy.
VITE_API_BASE_URL=
# Use the clinician host's same-origin proxy to avoid browser CORS failures.
VITE_XCA_BRIDGE_URL=/xca-bridge
VITE_CLINICAL_MODEL_VERSION_ID=2
VITE_CT_AI_PIPELINE_READY=true
VITE_CT_AI_MODEL_VERSION_ID=4

VITE_AI_DEMO_PLAYBACK=true
VITE_AI_DEMO_DURATION_MS=5000
